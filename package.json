{
  "name": "kashas-royal-website",
  "private": true,
  "version": "1.0.0",
  "description": "Official multi-page website for Kashas Royal — banqueting and event venue in Romford.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check:rules": "node scripts/check-rules.mjs",
    "check:media": "node scripts/check-media.mjs"
  },
  "dependencies": {
    "framer-motion": "^11.18.2",
    "lenis": "^1.3.27",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.6"
  }
}
